import React, { useState } from 'react';
import { DirectionData } from '../contexts/DataInterfaces';

interface LogSpecificationsProps {
  direction: DirectionData;
  routeId: string;
  directionId: string;
  globalData: any;
}

const LogSpecifications: React.FC<LogSpecificationsProps> = ({ 
  direction, 
  routeId, 
  directionId, 
  globalData 
}) => {
  const [expandedSections, setExpandedSections] = useState<Set<string>>(new Set());

  const toggleSection = (section: string) => {
    setExpandedSections(prev => {
      const newSet = new Set(prev);
      if (newSet.has(section)) {
        newSet.delete(section);
      } else {
        newSet.add(section);
      }
      return newSet;
    });
  };

  const stopIdsInDirection = direction.stop_ids_in_direction;
  
  if (!stopIdsInDirection) {
    return <div className="text-gray-500 text-sm">No log specifications available.</div>;
  }

  // Sort stops by position
  const sortedStops = Object.entries(stopIdsInDirection)
    .sort(([a], [b]) => parseInt(a) - parseInt(b))
    .map(([position, stopData]: [string, any]) => ({
      position: parseInt(position),
      ...stopData
    }));

  return (
    <div className="bg-white border border-gray-200 rounded-lg p-4">
      <h4 className="text-lg font-semibold mb-4 text-gray-900">Log Specifications</h4>
      
      <div className="space-y-4">
        
        {/* Direction-Level Logs */}
        <LogSection
          title="Direction-Level Logs"
          sectionKey="direction"
          isExpanded={expandedSections.has('direction')}
          onToggle={() => toggleSection('direction')}
        >
          <div className="space-y-3">
            <LogKeyGroup
              title="Direction Labels"
              keys={[`direction_topology_${routeId}_direction_id_${directionId}`]}
              globalData={globalData}
              keyType="labels"
            />
            <LogKeyGroup
              title="Direction Violations"
              keys={[`direction_topology_${routeId}_direction_id_${directionId}`]}
              globalData={globalData}
              keyType="violations"
            />
          </div>
        </LogSection>

        {/* Stop-Level Logs */}
        <LogSection
          title="Stop-Level Logs"
          sectionKey="stops"
          isExpanded={expandedSections.has('stops')}
          onToggle={() => toggleSection('stops')}
        >
          <div className="space-y-4">
            {sortedStops.map((stop) => (
              <div key={stop.stop_id} className="border border-gray-100 rounded-lg p-3">
                <h6 className="font-medium text-gray-900 mb-3">
                  Position {stop.position}: {stop.stop_name}
                </h6>
                
                <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
                  <div>
                    <LogKeyGroup
                      title="Labels"
                      keys={stop.stop_id_label_keys || []}
                      globalData={globalData}
                      keyType="labels"
                    />
                  </div>
                  <div>
                    <LogKeyGroup
                      title="Violations"
                      keys={stop.stop_id_violation_keys || []}
                      globalData={globalData}
                      keyType="violations"
                    />
                  </div>
                </div>
                
                <div className="mt-3">
                  <LogKeyGroup
                    title="Performance Analytics"
                    keys={stop.stop_id_performance_keys || []}
                    globalData={globalData}
                    keyType="performance"
                  />
                </div>
              </div>
            ))}
          </div>
        </LogSection>

        {/* Summary Statistics */}
        <LogSection
          title="Summary Statistics"
          sectionKey="summary"
          isExpanded={expandedSections.has('summary')}
          onToggle={() => toggleSection('summary')}
        >
          <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div className="text-center p-3 bg-blue-50 rounded-lg">
              <div className="text-2xl font-bold text-blue-600">
                {sortedStops.reduce((sum, stop) => sum + (stop.stop_id_label_keys?.length || 0), 0)}
              </div>
              <div className="text-sm text-blue-800">Total Labels</div>
            </div>
            <div className="text-center p-3 bg-red-50 rounded-lg">
              <div className="text-2xl font-bold text-red-600">
                {sortedStops.reduce((sum, stop) => sum + (stop.stop_id_violation_keys?.length || 0), 0)}
              </div>
              <div className="text-sm text-red-800">Total Violations</div>
            </div>
            <div className="text-center p-3 bg-green-50 rounded-lg">
              <div className="text-2xl font-bold text-green-600">
                {sortedStops.reduce((sum, stop) => sum + (stop.stop_id_performance_keys?.length || 0), 0)}
              </div>
              <div className="text-sm text-green-800">Total Analytics</div>
            </div>
            <div className="text-center p-3 bg-amber-50 rounded-lg">
              <div className="text-2xl font-bold text-amber-600">
                {sortedStops.filter(stop => 
                  stop.stop_id_label_keys?.some((key: string) => key.includes('regulatory_stops'))
                ).length}
              </div>
              <div className="text-sm text-amber-800">Regulatory Stops</div>
            </div>
          </div>
        </LogSection>
      </div>
    </div>
  );
};

interface LogSectionProps {
  title: string;
  sectionKey: string;
  isExpanded: boolean;
  onToggle: () => void;
  children: React.ReactNode;
}

const LogSection: React.FC<LogSectionProps> = ({ 
  title, 
  isExpanded, 
  onToggle, 
  children 
}) => {
  return (
    <div className="border border-gray-200 rounded-lg">
      <button
        onClick={onToggle}
        className="w-full px-4 py-3 text-left flex items-center justify-between bg-gray-50 rounded-t-lg hover:bg-gray-100 transition-colors"
      >
        <h5 className="font-medium text-gray-900">{title}</h5>
        <svg 
          className={`w-5 h-5 text-gray-500 transition-transform ${isExpanded ? 'rotate-180' : ''}`}
          fill="none" 
          stroke="currentColor" 
          viewBox="0 0 24 24"
        >
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      
      {isExpanded && (
        <div className="p-4 border-t border-gray-200">
          {children}
        </div>
      )}
    </div>
  );
};

interface LogKeyGroupProps {
  title: string;
  keys: string[];
  globalData: any;
  keyType: 'labels' | 'violations' | 'performance';
}

const LogKeyGroup: React.FC<LogKeyGroupProps> = ({ 
  title, 
  keys, 
  globalData, 
  keyType 
}) => {
  const getKeyColor = (keyType: string) => {
    switch (keyType) {
      case 'labels': return 'bg-blue-50 text-blue-700 border-blue-200';
      case 'violations': return 'bg-red-50 text-red-700 border-red-200';
      case 'performance': return 'bg-green-50 text-green-700 border-green-200';
      default: return 'bg-gray-50 text-gray-700 border-gray-200';
    }
  };

  const getDataFromKey = (key: string) => {
    switch (keyType) {
      case 'labels': return globalData?.labels?.[key];
      case 'violations': return globalData?.violations?.[key];
      case 'performance': return globalData?.performance?.[key];
      default: return null;
    }
  };

  if (!keys || keys.length === 0) {
    return (
      <div className="text-sm text-gray-500">
        <strong>{title}:</strong> None
      </div>
    );
  }

  return (
    <div>
      <h6 className="text-sm font-medium text-gray-700 mb-2">{title} ({keys.length})</h6>
      <div className="space-y-2 max-h-40 overflow-y-auto">
        {keys.map((key, index) => {
          const data = getDataFromKey(key);
          return (
            <div 
              key={index} 
              className={`text-xs p-2 rounded border ${getKeyColor(keyType)}`}
            >
              <div className="font-mono break-all mb-1">{key}</div>
              {data && (
                <div className="text-gray-600">
                  {keyType === 'performance' && data.analytics?.punctuality && (
                    <span>
                      Sample: {data.analytics.punctuality.sample_size} • 
                      On Time: {data.analytics.punctuality.punctuality_distribution.percentages.on_time}%
                    </span>
                  )}
                  {(keyType === 'labels' || keyType === 'violations') && data.description && (
                    <span>{data.description}</span>
                  )}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  );
};

export default LogSpecifications;